#pragma code_page(65001)

#include <windows.h>
#include "version.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// The installer points "Layout Display Name" at string 1000, which Windows shows in its layout list.
STRINGTABLE
BEGIN
    1000 "Özbekça Tugmali (Xattot)"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION XATTOT_VERSION
PRODUCTVERSION XATTOT_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_DRV_KEYBOARD
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004B0"
        BEGIN
            VALUE "CompanyName", "Sanjar Barakayev"
            VALUE "FileDescription", "Özbekça Tugmali (Xattot) Keyboard Layout"
            VALUE "FileVersion", XATTOT_VERSION_STR
            VALUE "InternalName", "kbduzxt"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "kbduzxt.dll"
            VALUE "ProductName", "Xattot"
            VALUE "ProductVersion", XATTOT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04B0
    END
END
