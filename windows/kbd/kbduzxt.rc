#pragma code_page(65001)

#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// The installer points "Layout Display Name" at string 1000, which Windows shows in its layout list.
STRINGTABLE
BEGIN
    1000 "Özbekça Tugmali (Xattot)"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_DRV_KEYBOARD
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004B0"
        BEGIN
            VALUE "CompanyName", "Sanjar Barakayev"
            VALUE "FileDescription", "Özbekça Tugmali (Xattot) Keyboard Layout"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "kbduzxt"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "kbduzxt.dll"
            VALUE "ProductName", "Xattot"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04B0
    END
END
