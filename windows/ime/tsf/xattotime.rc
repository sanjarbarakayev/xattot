#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// windows\build.bat puts inputmethod\Resources and assets on the include path.
IDI_XATTOT ICON "Xattot.ico"
IDR_ENGLISH_WORDS RCDATA "english-words.txt"
IDR_UZBEK_EXCEPTIONS RCDATA "uzbek-exceptions.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION XATTOT_VERSION
PRODUCTVERSION XATTOT_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004B0"
        BEGIN
            VALUE "CompanyName", "Sanjar Barakayev"
            VALUE "FileDescription", "Özbekça (Xattot) Input Method"
            VALUE "FileVersion", XATTOT_VERSION_STR
            VALUE "InternalName", "XattotIME"
            VALUE "LegalCopyright", "MIT License; English word list from SCOWL, see SCOWL-COPYRIGHT.txt"
            VALUE "OriginalFilename", "XattotIME.dll"
            VALUE "ProductName", "Xattot"
            VALUE "ProductVersion", XATTOT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04B0
    END
END
